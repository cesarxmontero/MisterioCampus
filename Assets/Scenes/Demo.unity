  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Durante las vacaciones de Navidad alguien rob\xF3 un libro de la biblioteca
    del campus. A las 23:00 solo hab\xEDa cuatro personas por all\xED, Josep, Ari,
    Luna y Nora.\n\nHabla con ellos, busca pistas por el campus y ap\xFAntalas en
    tu libreta. Quien estaba en la biblioteca a esa hora es quien rob\xF3 el libro.\n\n\xB7
    <b>A y D</b> para andar\n\xB7  <b>E</b> para hablar, mirar y cruzar puertas\n\xB7 
    <b>Tab</b> para la libreta"
  m_isRightToLeft: 0
